# Copy to .env. Generate independent random values with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PUBLIC_ORIGIN=https://plant.example.internal
HTTPS_PORT=443
HTTP_PORT=80
MYSQL_ROOT_PASSWORD=replace_with_random_hex
AUTH_DB_PASSWORD=replace_with_random_hex
BAG_DB_PASSWORD=replace_with_random_hex
AUTH_SECRET=replace_with_at_least_32_random_characters
SERVICE_TOKEN=replace_with_at_least_32_random_characters
BOOTSTRAP_EMAIL=admin@example.internal
BOOTSTRAP_NAME=Admin Portal
BOOTSTRAP_PASSWORD=replace_with_a_unique_temporary_password
# Local scripts only; container URLs are set by Compose. Percent-encode credentials in URLs.
AUTH_DATABASE_URL=mysql://plant_auth:replace_with_random_hex@localhost:3306/plant_auth
BAG_DATABASE_URL=mysql://plant_bag:replace_with_random_hex@localhost:3306/plant_bag_filter
AUTH_MIGRATION_DATABASE_URL=mysql://root:replace_with_random_hex@localhost:3306/plant_auth
BAG_MIGRATION_DATABASE_URL=mysql://root:replace_with_random_hex@localhost:3306/plant_bag_filter
AUTH_INTERNAL_URL=http://localhost:3001
